@model GestorInventario.Models.MovimientoStock

@{
    ViewData["Title"] = "Detalle del Movimiento";
}

<div class="row justify-content-center">
    <div class="col-md-6">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="mb-0">Detalle del Movimiento</h2>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Volver
            </a>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <dl class="row">
                    <dt class="col-sm-5 text-muted">Producto</dt>
                    <dd class="col-sm-7">
                        <a asp-controller="Productos" asp-action="Details"
                           asp-route-id="@Model.ProductoId">
                            @Model.Producto?.Nombre
                        </a>
                    </dd>

                    <dt class="col-sm-5 text-muted">Tipo</dt>
                    <dd class="col-sm-7">
                        @if (Model.Tipo == GestorInventario.Models.TipoMovimiento.Entrada)
                        {
                            <span class="badge bg-success fs-6">↑ Entrada</span>
                        }
                        else if (Model.Tipo == GestorInventario.Models.TipoMovimiento.Salida)
                        {
                            <span class="badge bg-danger fs-6">↓ Salida</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary fs-6">⇄ Ajuste</span>
                        }
                    </dd>

                    <dt class="col-sm-5 text-muted">Cantidad</dt>
                    <dd class="col-sm-7 fw-bold fs-5">@Model.Cantidad unidades</dd>

                    <dt class="col-sm-5 text-muted">Stock resultante</dt>
                    <dd class="col-sm-7">
                        <span class="badge bg-dark fs-6">@Model.StockResultante uds.</span>
                    </dd>

                    <dt class="col-sm-5 text-muted">Fecha</dt>
                    <dd class="col-sm-7">@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</dd>

                    <dt class="col-sm-5 text-muted">Notas</dt>
                    <dd class="col-sm-7">@(Model.Notas ?? "—")</dd>
                </dl>

                <div class="alert alert-info mt-3 mb-0 small">
                    <i class="bi bi-info-circle"></i>
                    Los movimientos de stock son registros de auditoría y no pueden modificarse ni eliminarse.
                </div>
            </div>
        </div>

    </div>
</div>
