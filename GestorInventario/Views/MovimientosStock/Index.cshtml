@model IEnumerable<GestorInventario.Models.MovimientoStock>

@{
    ViewData["Title"] = "Historial de Movimientos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Historial de Movimientos</h2>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-lg"></i> Registrar movimiento
    </a>
</div>

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Exito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">No hay movimientos registrados todavía.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Fecha</th>
                    <th>Producto</th>
                    <th class="text-center">Tipo</th>
                    <th class="text-center">Cantidad</th>
                    <th class="text-center">Stock resultante</th>
                    <th>Notas</th>
                    <th class="text-center">Detalle</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var mov in Model)
                {
                    <tr>
                        <td class="text-muted small">@mov.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            <a asp-controller="Productos" asp-action="Details"
                               asp-route-id="@mov.ProductoId" class="text-decoration-none">
                                @mov.Producto?.Nombre
                            </a>
                        </td>
                        <td class="text-center">
                            @if (mov.Tipo == GestorInventario.Models.TipoMovimiento.Entrada)
                            {
                                <span class="badge bg-success">↑ Entrada</span>
                            }
                            else if (mov.Tipo == GestorInventario.Models.TipoMovimiento.Salida)
                            {
                                <span class="badge bg-danger">↓ Salida</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">⇄ Ajuste</span>
                            }
                        </td>
                        <td class="text-center fw-bold">@mov.Cantidad</td>
                        <td class="text-center">
                            <span class="badge bg-dark">@mov.StockResultante uds.</span>
                        </td>
                        <td class="text-muted small">@(mov.Notas ?? "—")</td>
                        <td class="text-center">
                            <a asp-action="Details" asp-route-id="@mov.Id"
                               class="btn btn-sm btn-outline-info">
                                <i class="bi bi-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
