@model GestorInventario.Models.LoginViewModel

@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = null; // Sin navbar, página limpia
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login — GestorInventario</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body class="bg-dark min-vh-100 d-flex align-items-center justify-content-center">

    <div class="card shadow-lg" style="width: 400px;">
        <div class="card-header bg-dark text-white text-center py-4">
            <h4 class="mb-0">📦 GestorInventario</h4>
            <small class="text-muted">Acceso al sistema</small>
        </div>
        <div class="card-body p-4">

            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold"></label>
                    <input asp-for="Email" class="form-control"
                           placeholder="usuario@empresa.com" autofocus />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Password" class="form-label fw-semibold"></label>
                    <input asp-for="Password" class="form-control"
                           placeholder="Contraseña" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label">Recordarme</label>
                    </div>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-primary btn-lg">
                        Iniciar sesión
                    </button>
                </div>
            </form>

        </div>
    </div>

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }
</body>
</html>