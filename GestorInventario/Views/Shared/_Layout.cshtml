<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GestorInventario</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css"> @*Iconos de bootstrap*@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GestorInventario.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark border-bottom border-secondary mb-3">
            <div class="container">

                @* Logo / nombre de la app *@
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-boxes"></i> GestorInventario
                </a>

                @* Botón hamburguesa para móvil *@
                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Productos" asp-action="Index">
                                <i class="bi bi-box-seam"></i> Productos
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Categorias" asp-action="Index">
                                <i class="bi bi-tag"></i> Categorías
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Proveedores" asp-action="Index">
                                <i class="bi bi-truck"></i> Proveedores
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="MovimientosStock" asp-action="Index">
                                <i class="bi bi-clock-history"></i> Movimientos
                            </a>
                        </li>

                    </ul>
                </div>
                @if (User.Identity!.IsAuthenticated)
                {
                    <span class="navbar-text text-muted me-3">@User.Identity.Name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-light btn-sm">
                            Cerrar sesión
                        </button>
                    </form>
                }
            </div>
            
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - GestorInventario - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
